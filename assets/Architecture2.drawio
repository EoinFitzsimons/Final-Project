<mxfile host="Electron">
  <diagram name="Simulation Engine Component Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell
          id="container"
          value="Simulation Engine"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="300" y="100" width="600" height="550" as="geometry" />
        </mxCell>

        <mxCell
          id="race"
          value="Race Controller&#xa;&#xa;race_controller.py&#xa;&#xa;Controls race lifecycle&#xa;Advances simulation state"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="470" y="170" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell
          id="driver"
          value="Driver Agent&#xa;&#xa;driver.py&#xa;pseudodriver.py&#xa;&#xa;Models driver behaviour&#xa;Maintains driver state"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="470" y="320" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell
          id="car"
          value="Vehicle Model&#xa;&#xa;car.py&#xa;&#xa;Stores vehicle attributes&#xa;Maintains car state"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="470" y="470" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell
          id="track"
          value="Track System&#xa;&#xa;track_geometry.py&#xa;&#xa;Processes track information"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="470" y="620" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell
          id="ui"
          value="PyQt6 UI"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="70" y="320" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell
          id="database"
          value="SQLite / JSON Data"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="1"
        >
          <mxGeometry x="950" y="320" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="edge1" edge="1" source="ui" target="race" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge2" edge="1" source="race" target="driver" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge3" edge="1" source="driver" target="car" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge4" edge="1" source="race" target="track" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge5" edge="1" source="race" target="database" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
